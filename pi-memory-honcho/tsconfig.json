{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"baseUrl": "."
	},
	"include": ["index.ts", "extensions/**/*.ts", "types/**/*.d.ts"]
}
